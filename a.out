#! /usr/local/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/local/lib/ivl/system.vpi";
:vpi_module "/usr/local/lib/ivl/vhdl_sys.vpi";
:vpi_module "/usr/local/lib/ivl/vhdl_textio.vpi";
:vpi_module "/usr/local/lib/ivl/v2005_math.vpi";
:vpi_module "/usr/local/lib/ivl/va_math.vpi";
:vpi_module "/usr/local/lib/ivl/v2009.vpi";
S_0x1185b620 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x11837020 .scope module, "tb" "tb" 3 3;
 .timescale 0 0;
v0x1187f160_0 .var "a", 0 0;
v0x1187f230_0 .var "b", 0 0;
v0x1187f300_0 .net "y", 0 0, L_0x1187f400;  1 drivers
S_0x118371b0 .scope module, "dut" "and_gate" 3 7, 4 3 0, S_0x11837020;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 1 "y";
L_0x1187f400 .functor AND 1, v0x1187f160_0, v0x1187f230_0, C4<1>, C4<1>;
v0x1186e170_0 .net "a", 0 0, v0x1187f160_0;  1 drivers
v0x1187ef50_0 .net "b", 0 0, v0x1187f230_0;  1 drivers
v0x1187f010_0 .net "y", 0 0, L_0x1187f400;  alias, 1 drivers
    .scope S_0x11837020;
T_0 ;
    %vpi_call/w 3 10 "$dumpfile", "dump.vcd" {0 0 0};
    %vpi_call/w 3 11 "$dumpvars", 32'sb00000000000000000000000000000001 {0 0 0};
    %vpi_call/w 3 13 "$display", "a b | y" {0 0 0};
    %vpi_call/w 3 14 "$monitor", "%b %b | %b", v0x1187f160_0, v0x1187f230_0, v0x1187f300_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x1187f160_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x1187f230_0, 0, 1;
    %delay 1, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x1187f160_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x1187f230_0, 0, 1;
    %delay 1, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x1187f160_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x1187f230_0, 0, 1;
    %delay 1, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x1187f160_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x1187f230_0, 0, 1;
    %delay 1, 0;
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "testbench.sv";
    "design.sv";
